# Copy this file to `.env` and fill in your keys. Never commit the real .env.

# Required: Groq API key (free tier) — https://console.groq.com
GROQ_API_KEY=

# --- Optional: LangSmith tracing (free tier) ---
# Set LANGSMITH_TRACING=true and add your key to trace every run in LangSmith.
# Without these, tracing is simply disabled and the app still works.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-data-analyst
