# Copy this file to `.env` and fill in your keys. Never commit the real .env.

# Required: Groq API key (free tier) — https://console.groq.com
GROQ_API_KEY=

# Optional but recommended: OpenRouter API key used as a fallback when Groq's
# free-tier TPM/TPD limits are hit. https://openrouter.ai/keys
# No-cost :free models are used automatically when this is set.
OPENROUTER_API_KEY=

# Which LLM provider to try first: "groq" or "openrouter" (default "openrouter").
# The other provider is used automatically on rate-limit/quota errors. Flip this
# anytime without code changes — set it to "groq" for the faster option, or keep
# "openrouter" while Groq's free tier is under heavy testing load.
LLM_PRIMARY_PROVIDER=openrouter

# --- Optional: LangSmith tracing (free tier) ---
# Set LANGSMITH_TRACING=true and add your key to trace every run in LangSmith.
# Without these, tracing is simply disabled and the app still works.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-data-analyst
